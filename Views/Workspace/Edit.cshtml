@model WorkStack.Models.ViewModels.CreateWorkspaceViewModel

@{
    ViewData["Title"] = "Edit Workspace";

    var workspaceId = (int)ViewData["WorkspaceId"]!;
}

<div class="container py-4">

    <div class="mb-4">

        <div class="text-muted small mb-1">
            Workspace Settings
        </div>

        <h1 class="mb-1">
            Edit Workspace
        </h1>

        <p class="text-muted mb-0">
            Update your workspace name and description.
        </p>

    </div>

    <div class="card">

        <div class="card-body">

            <form asp-controller="Workspace"
                  asp-action="Edit"
                  asp-route-id="@workspaceId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Workspace Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           maxlength="100"
                           autocomplete="off"
                           autofocus />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Describe what this workspace is for.">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Workspace"
                       asp-action="Details"
                       asp-route-id="@workspaceId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}