@model IEnumerable<WorkStack.Models.ViewModels.WorkspaceMemberViewModel>

@{
    ViewData["Title"] = "Workspace members";
    var workspaceId = (int)ViewData["WorkspaceId"]!;
    var showRemoveColumn = Model.Any(member => member.CanBeRemovedByCurrentUser);
}

<h1>Workspace members</h1>

@if (ViewData["CanManageMembers"] is true)
{
    <a asp-action="AddMember" asp-route-id="@workspaceId" class="btn btn-primary mb-3">Add member</a>
}

@if (!Model.Any())
{
    <p>This workspace has no members yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Joined date</th>
                @if (showRemoveColumn)
                {
                    <th scope="col">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@(member.Email ?? "Email unavailable")</td>
                    <td>@member.Role</td>
                    <td>@member.JoinedAt.ToString("d")</td>
                    @if (showRemoveColumn)
                    {
                        <td>
                            @if (member.CanBeRemovedByCurrentUser)
                            {
                                <form asp-action="RemoveMember" asp-route-workspaceId="@workspaceId" asp-route-userId="@member.UserId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to remove this member?');">Remove</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Details" asp-route-id="@workspaceId" class="btn btn-secondary">Back to workspace</a>
