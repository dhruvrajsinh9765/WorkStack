@model IEnumerable<WorkStack.Models.ViewModels.WorkspaceMemberViewModel>

@{
    ViewData["Title"] = "Workspace members";

    var workspaceId = (int)ViewData["WorkspaceId"]!;

    var canManageMembers =
        ViewData["CanManageMembers"] is true;

    var showActionsColumn =
        Model.Any(member =>
            member.CanBeRemovedByCurrentUser ||
            member.CanChangeRole);

    var memberCount = Model.Count();
}

<div class="ws-members-page">

    <!-- =========================================================
         BACK NAVIGATION
         ========================================================= -->

    <a asp-action="Details"
       asp-route-id="@workspaceId"
       class="ws-members-back-link">

        <span aria-hidden="true">←</span>

        <span>Back to workspace</span>

    </a>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="ws-members-header">

        <div>

            <p class="ws-members-eyebrow">
                WORKSPACE / PEOPLE
            </p>

            <h1>
                Workspace members
            </h1>

            <p>
                Manage the people who have access to this workspace
                and control their workspace roles.
            </p>

        </div>

        @if (canManageMembers)
        {
            <a asp-action="AddMember"
               asp-route-id="@workspaceId"
               class="ws-members-primary-action">

                <span aria-hidden="true">+</span>

                Add member

            </a>
        }

    </section>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["MemberRemoveError"] is string removeError)
    {
        <div class="ws-members-alert ws-members-alert-warning"
             role="alert">

            <div class="ws-members-alert-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <path d="M12 4 3.8 19h16.4z"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 16.5h.01"></path>
                </svg>

            </div>

            <div>

                <strong>
                    Member could not be removed
                </strong>

                <p>
                    @removeError
                </p>

            </div>

        </div>
    }

    @if (TempData["MemberRemoveSuccess"] is string removeSuccess)
    {
        <div class="ws-members-alert ws-members-alert-success"
             role="alert">

            <div class="ws-members-alert-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <path d="m5 12 4 4L19 6"></path>
                </svg>

            </div>

            <div>

                <strong>
                    Member removed
                </strong>

                <p>
                    @removeSuccess
                </p>

            </div>

        </div>
    }


    <!-- =========================================================
         MEMBERS SUMMARY
         ========================================================= -->

    <section class="ws-members-summary">

        <div class="ws-members-summary-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3"></circle>
                <path d="M3.5 19c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"></path>
                <path d="M16 11a2.5 2.5 0 1 0 0-5"></path>
                <path d="M17 14.5c2 .4 3.2 1.7 3.5 4"></path>
            </svg>

        </div>

        <div class="ws-members-summary-copy">

            <strong>
                @memberCount
                @(memberCount == 1 ? "member" : "members")
            </strong>

            <span>
                People currently connected to this workspace.
            </span>

        </div>

    </section>


    <!-- =========================================================
         EMPTY STATE
         ========================================================= -->
    @if (!Model.Any())
    {
        <section class="ws-members-empty">

            <div class="ws-members-empty-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <circle cx="9" cy="8" r="3"></circle>
                    <path d="M3.5 19c.7-3 2.5-4.5 5.5-4.5s4.8 1.5 5.5 4.5"></path>
                    <path d="M16 12h5"></path>
                    <path d="M18.5 9.5v5"></path>
                </svg>

            </div>

            <h2>
                No members yet
            </h2>

            <p>
                Add people to this workspace to start collaborating
                with your team.
            </p>

            @if (canManageMembers)
            {
                <a asp-action="AddMember"
                   asp-route-id="@workspaceId"
                   class="ws-members-empty-action">

                    Add the first member

                </a>
            }

        </section>
    }
    else
    {
        <!-- =====================================================
             MEMBERS TABLE
             ===================================================== -->

        <section class="ws-members-table-card">

            <div class="ws-members-table-header">

                <div>

                    <p class="ws-members-table-eyebrow">
                        PEOPLE WITH ACCESS
                    </p>

                    <h2>
                        Members
                    </h2>

                </div>

                <span class="ws-members-table-count">
                    @memberCount
                </span>

            </div>


            <div class="table-responsive">

                <table class="ws-members-table">

                    <thead>

                        <tr>

                            <th>
                                Member
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Joined
                            </th>

                            @if (showActionsColumn)
                            {
                                <th class="ws-members-actions-heading">
                                    Actions
                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var member in Model)
                        {
                            var email =
                                member.Email
                                ?? "Email unavailable";

                            var memberInitial =
                                string.IsNullOrWhiteSpace(email)
                                    ? "?"
                                    : email
                                        .Trim()
                                        .Substring(0, 1)
                                        .ToUpperInvariant();

                            var roleClass =
                                member.Role switch
                                {
                                    WorkStack.Models.Enums.WorkspaceRole.Owner
                                        => "ws-member-role-owner",

                                    WorkStack.Models.Enums.WorkspaceRole.Manager
                                        => "ws-member-role-manager",

                                    _
                                        => "ws-member-role-member"
                                };

                            <tr>

                                <!-- MEMBER -->

                                <td>

                                    <div class="ws-member-identity">

                                        <div class="ws-member-avatar"
                                             aria-hidden="true">

                                            @memberInitial

                                        </div>

                                        <div class="ws-member-identity-copy">

                                            <strong>
                                                @email
                                            </strong>

                                            <span>
                                                WorkStack member
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- ROLE -->

                                <td>

                                    <span class="ws-member-role @roleClass">
                                        @member.Role
                                    </span>

                                </td>


                                <!-- JOINED -->

                                <td>

                                    <span class="ws-member-joined">
                                        @member.JoinedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                    </span>

                                </td>


                                <!-- ACTIONS -->
                                @if (showActionsColumn)
                                {
                                    <td class="ws-members-actions-cell">

                                        <div class="ws-member-actions">

                                            @if (member.CanChangeRole)
                                            {
                                                <a asp-action="ChangeMemberRole"
                                                   asp-route-workspaceId="@workspaceId"
                                                   asp-route-userId="@member.UserId"
                                                   class="ws-member-action-secondary">

                                                    Change role

                                                </a>
                                            }

                                            @if (member.CanBeRemovedByCurrentUser)
                                            {
                                                <form asp-action="RemoveMember"
                                                      asp-route-workspaceId="@workspaceId"
                                                      asp-route-userId="@member.UserId"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to remove this member?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="ws-member-action-danger">

                                                        Remove

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>
    }


    <!-- =========================================================
         FOOTER NAVIGATION
         ========================================================= -->

    <div class="ws-members-footer">

        <a asp-action="Details"
           asp-route-id="@workspaceId"
           class="ws-members-back-button">

            <span aria-hidden="true">←</span>

            Back to workspace

        </a>

    </div>

</div>