@model WorkStack.Models.ViewModels.AddWorkspaceMemberViewModel

@{
    ViewData["Title"] = "Add workspace member";

    var workspaceId = (int)ViewData["WorkspaceId"]!;
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <div class="text-muted small mb-1">
            Workspace
        </div>

        <h1 class="mb-2">
            Add workspace member
        </h1>

        <p class="text-muted mb-0">
            Invite an existing WorkStack user to this workspace.
        </p>

    </div>


    @if (ViewData["CanAssignManager"] is false)
    {
        <div class="alert alert-info mb-4" role="alert">

            You can add Members to this workspace.
            Only the workspace Owner can add a Manager.

        </div>
    }


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="AddMember"
                  asp-route-id="@workspaceId"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">

                        User email

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           placeholder="user@example.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        The user must already have a WorkStack account.
                    </div>

                </div>


                <!-- Role -->
                <div class="mb-4">

                    <label asp-for="Role"
                           class="form-label">

                        Workspace role

                    </label>


                    @if (ViewData["CanAssignManager"] is false)
                    {
                        <input type="hidden"
                               asp-for="Role"
                               value="3" />

                        <select class="form-select"
                                disabled>

                            <option value="3">
                                Member
                            </option>

                        </select>
                    }
                    else
                    {
                        <select asp-for="Role"
                                class="form-select">

                            <option value="3">
                                Member
                            </option>

                            <option value="2">
                                Manager
                            </option>

                        </select>
                    }


                    <span asp-validation-for="Role"
                          class="text-danger">
                    </span>

                </div>


                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Add member

                    </button>


                    <a asp-action="Members"
                       asp-route-id="@workspaceId"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}