@model WorkStack.Models.ViewModels.AddWorkspaceMemberViewModel

@{
    ViewData["Title"] = "Add workspace member";

    var workspaceId = (int)ViewData["WorkspaceId"]!;

    var canAssignManager =
        ViewData["CanAssignManager"] is true;
}

<div class="container-fluid py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="mb-4">

        <div class="text-muted small mb-1">
            Workspace
        </div>

        <h1 class="mb-2">
            Add workspace member
        </h1>

        <p class="text-muted mb-0">
            Invite an existing WorkStack user to this workspace.
        </p>

    </div>


    <!-- =========================================================
         ROLE INFORMATION
         ========================================================= -->
    @if (!canAssignManager)
    {
        <div class="alert alert-info mb-4"
             role="alert">

            <strong>Manager access:</strong>
            You can add Members to this workspace.
            Only the workspace Owner can add a Manager.

        </div>
    }
    else
    {
        <div class="alert alert-secondary mb-4"
             role="alert">

            You can add either a Member or a Manager to this workspace.

        </div>
    }


    <!-- =========================================================
         ADD MEMBER FORM
         ========================================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="AddMember"
                  asp-route-id="@workspaceId"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- =================================================
                     MODEL VALIDATION
                     ================================================= -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- =================================================
                     CONTROLLER ERROR
                     ================================================= -->
                @if (TempData["AddMemberError"] is string addMemberError)
                {
                    <div class="alert alert-danger"
                         role="alert">

                        @addMemberError

                    </div>
                }


                <!-- =================================================
                     EMAIL
                     ================================================= -->

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">

                        User email

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           placeholder="user@example.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        The user must already have a WorkStack account.
                    </div>

                </div>


                <!-- =================================================
                     ROLE
                     ================================================= -->

                <div class="mb-4">

                    <label asp-for="Role"
                           class="form-label">

                        Workspace role

                    </label>


                    @if (canAssignManager)
                    {
                        <!-- OWNER -->

                        <select asp-for="Role"
                                class="form-select">

                            <option value="3">
                                Member
                            </option>

                            <option value="2">
                                Manager
                            </option>

                        </select>
                    }
                    else
                    {
                        <!-- MANAGER -->

                        <input type="hidden"
                               asp-for="Role"
                               value="3" />

                        <select class="form-select"
                                disabled>

                            <option value="3">
                                Member
                            </option>

                        </select>
                    }


                    <span asp-validation-for="Role"
                          class="text-danger">
                    </span>


                    @if (canAssignManager)
                    {
                        <div class="form-text">
                            Members have standard workspace access.
                            Managers can manage workspace members.
                        </div>
                    }
                    else
                    {
                        <div class="form-text">
                            Managers can add Members, but only the Owner
                            can add another Manager.
                        </div>
                    }

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Add member

                    </button>


                    <a asp-action="Members"
                       asp-route-id="@workspaceId"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}