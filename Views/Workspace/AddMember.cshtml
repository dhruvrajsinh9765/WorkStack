@model WorkStack.Models.ViewModels.AddWorkspaceMemberViewModel

@using WorkStack.Models.Enums

@{
    ViewData["Title"] = "Add workspace member";

    var workspaceId = (int)ViewData["WorkspaceId"]!;

    var currentWorkspaceRole =
        ViewData["CurrentWorkspaceRole"] is WorkspaceRole role
            ? role
            : WorkspaceRole.Member;

    var canAssignManager =
        currentWorkspaceRole == WorkspaceRole.Owner;
}


<div class="ws-member-form-page">


    <!-- =========================================================
         BACK NAVIGATION
         ========================================================= -->

    <a asp-action="Members"
       asp-route-id="@workspaceId"
       class="ws-member-form-back-link">

        <span aria-hidden="true">
            ←
        </span>

        Back to members

    </a>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="ws-member-form-header">

        <p class="ws-members-eyebrow">
            WORKSPACE / PEOPLE
        </p>

        <h1>
            Add workspace member
        </h1>

        <p>
            Give an existing WorkStack user access to this workspace.
        </p>

    </section>


    <!-- =========================================================
         ROLE INFORMATION
         ========================================================= -->

    <section class="ws-member-permission-notice">

        <div class="ws-member-permission-icon"
             aria-hidden="true">

            <svg viewBox="0 0 24 24">

                <circle cx="12"
                        cy="12"
                        r="8">
                </circle>

                <path d="M12 10v5">
                </path>

                <path d="M12 7.5h.01">
                </path>

            </svg>

        </div>


        <div>

            @if (canAssignManager)
            {
                <strong>
                    Owner access
                </strong>

                <p>
                    You are the workspace Owner.
                    You can add Members or Managers to this workspace.
                </p>
            }
            else
            {
                <strong>
                    Manager access
                </strong>

                <p>
                    You can add Members to this workspace.
                    Only the workspace Owner can add a Manager.
                </p>
            }

        </div>

    </section>


    <!-- =========================================================
         FORM
         ========================================================= -->

    <section class="ws-member-form-card">

        <div class="ws-member-form-card-header">

            <p class="ws-members-eyebrow">
                MEMBER ACCESS
            </p>

            <h2>
                Member details
            </h2>

            <p>
                The user must already have a WorkStack account.
            </p>

        </div>


        <form asp-action="AddMember"
              asp-route-id="@workspaceId"
              method="post"
              class="ws-member-form">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 VALIDATION SUMMARY
                 ================================================= -->

            <div asp-validation-summary="ModelOnly"
                 class="ws-member-validation-summary">
            </div>


            <!-- =================================================
                 TEMP DATA ERROR
                 ================================================= -->
            @if (TempData["AddMemberError"] is string addMemberError)
            {
                <div class="ws-member-form-error"
                     role="alert">

                    <strong>
                        Member could not be added
                    </strong>

                    <p>
                        @addMemberError
                    </p>

                </div>
            }


            <!-- =================================================
                 EMAIL
                 ================================================= -->

            <div class="ws-member-form-field">

                <label asp-for="Email">
                    User email
                </label>

                <input asp-for="Email"
                       type="email"
                       placeholder="user@example.com"
                       autocomplete="email"
                       class="ws-member-form-input"
                       autofocus />

                <span asp-validation-for="Email"
                      class="ws-member-validation">
                </span>

                <span class="ws-member-form-help">
                    Enter the email address associated with
                    the user's WorkStack account.
                </span>

            </div>


            <!-- =================================================
                 ROLE
                 ================================================= -->

            <div class="ws-member-form-field">

                <label asp-for="Role">
                    Workspace role
                </label>


                @if (canAssignManager)
                {
                    <!-- OWNER CAN SELECT MEMBER OR MANAGER -->

                    <select asp-for="Role"
                            class="ws-member-form-input">

                        <option value="@WorkspaceRole.Member">
                            Member
                        </option>

                        <option value="@WorkspaceRole.Manager">
                            Manager
                        </option>

                    </select>
                }
                else
                {
                    <!-- MANAGER CAN ONLY ADD MEMBER -->

                    <input type="hidden"
                           asp-for="Role"
                           value="@WorkspaceRole.Member" />

                    <select class="ws-member-form-input"
                            disabled>

                        <option value="@WorkspaceRole.Member">
                            Member
                        </option>

                    </select>
                }


                <span asp-validation-for="Role"
                      class="ws-member-validation">
                </span>


                <!-- =================================================
                     ROLE EXPLANATION
                     ================================================= -->

                <div class="ws-member-role-explanation">

                    <div class="ws-member-role-explanation-item">

                        <span class="ws-member-role-dot
                            ws-member-role-dot-member">
                        </span>

                        <div>

                            <strong>
                                Member
                            </strong>

                            <span>
                                Standard workspace access.
                            </span>

                        </div>

                    </div>


                    @if (canAssignManager)
                    {
                        <div class="ws-member-role-explanation-item">

                            <span class="ws-member-role-dot
                                ws-member-role-dot-manager">
                            </span>

                            <div>

                                <strong>
                                    Manager
                                </strong>

                                <span>
                                    Can manage workspace members.
                                </span>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="ws-member-form-actions">

                <button type="submit"
                        class="ws-member-form-primary-action">

                    Add member

                </button>


                <a asp-action="Members"
                   asp-route-id="@workspaceId"
                   class="ws-member-form-secondary-action">

                    Cancel

                </a>

            </div>

        </form>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}