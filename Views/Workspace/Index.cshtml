@model IEnumerable<WorkStack.Models.Workspace>

@{
    ViewData["Title"] = "Workspaces";
    var search = ViewData["Search"] as string ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Workspaces</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Create workspace
    </a>
</div>

<!-- WORKSPACE SEARCH -->
<form asp-action="Index"
      method="get"
      class="mb-4">

    <div class="input-group">
        <input type="text"
               name="search"
               value="@search"
               class="form-control"
               placeholder="Search workspaces by name or description..."
               aria-label="Search workspaces" />

        <button type="submit"
                class="btn btn-outline-primary">
            Search
        </button>

        @if (!string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        }
    </div>
</form>

@if (!Model.Any())
{
    @if (string.IsNullOrWhiteSpace(search))
    {
        <p>You are not a member of any workspaces yet.</p>
    }
    else
    {
        <div class="alert alert-secondary">
            No workspaces found matching
            <strong>@search</strong>.
        </div>
    }
}
else
{
    <div class="list-group">
        @foreach (var workspace in Model)
        {
            <div class="list-group-item">
                <h2 class="h5 mb-1">
                    @workspace.Name
                </h2>

                @if (!string.IsNullOrWhiteSpace(workspace.Description))
                {
                    <p class="mb-0">
                        @workspace.Description
                    </p>
                }

                <a asp-action="Details"
                   asp-route-id="@workspace.Id"
                   class="btn btn-outline-primary btn-sm mt-2">
                    Open workspace
                </a>
            </div>
        }
    </div>
}