@{
    ViewData["Title"] = "Create List";

    var workspaceId = (int)ViewData["WorkspaceId"]!;
    var boardId = (int)ViewData["BoardId"]!;
    var boardName = ViewData["BoardName"]?.ToString() ?? "Board";
}

<div class="ws-list-form-page">

    <a asp-controller="Board"
       asp-action="Details"
       asp-route-workspaceId="@workspaceId"
       asp-route-boardId="@boardId"
       class="ws-list-form-back">

        <span aria-hidden="true">←</span>
        <span>Back to board</span>

    </a>


    <div class="ws-list-form-layout">

        <!-- INTRO -->

        <section class="ws-list-form-intro">

            <div class="ws-list-form-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                    <path d="M8 9h8"></path>
                    <path d="M8 13h5"></path>
                </svg>

            </div>

            <p class="ws-list-form-eyebrow">
                NEW LIST
            </p>

            <h1>
                Create a list
            </h1>

            <p>
                Add a new stage to your workflow and give your
                team a clear place to organize tasks.
            </p>


            <div class="ws-list-form-context">

                <span class="ws-list-form-context-label">
                    BOARD
                </span>

                <strong>
                    @boardName
                </strong>

            </div>

        </section>


        <!-- FORM -->

        <section class="ws-list-form-card">

            <div class="ws-list-form-card-header">

                <div>

                    <span class="ws-list-form-card-label">
                        LIST DETAILS
                    </span>

                    <h2>
                        Define the workflow stage
                    </h2>

                    <p>
                        Give this list a simple name that describes its purpose.
                    </p>

                </div>

            </div>


            <form asp-controller="List"
                  asp-action="Create"
                  asp-route-workspaceId="@workspaceId"
                  asp-route-boardId="@boardId"
                  method="post"
                  class="ws-list-form">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="ws-list-validation-summary"
                     role="alert">
                </div>


                <div class="ws-list-form-field">

                    <label for="name"
                           class="ws-list-form-label">
                        List name
                    </label>

                    <input type="text"
                           id="name"
                           name="name"
                           class="ws-list-form-input"
                           maxlength="100"
                           placeholder="e.g. To Do"
                           autocomplete="off"
                           autofocus />


                    @Html.ValidationMessage(
                        "name",
                        new { @class = "ws-list-form-error" })


                    <span class="ws-list-form-hint">
                        Use a short name such as To Do, In Progress, or Done.
                    </span>

                </div>


                <div class="ws-list-form-actions">

                    <a asp-controller="Board"
                       asp-action="Details"
                       asp-route-workspaceId="@workspaceId"
                       asp-route-boardId="@boardId"
                       class="ws-list-form-cancel">

                        Cancel

                    </a>


                    <button type="submit"
                            class="ws-list-form-submit">

                        Create list

                        <span aria-hidden="true">→</span>

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}