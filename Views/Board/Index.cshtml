@model WorkStack.Models.ViewModels.WorkspaceBoardsViewModel

@{
    ViewData["Title"] = "Boards";

    var search = Model.Search?.Trim() ?? string.Empty;
    var hasSearch = !string.IsNullOrWhiteSpace(search);
    var boardCount = Model.Boards.Count;
}

<div class="ws-boards-page">

    <!-- =========================================================
         BACK TO WORKSPACE
         ========================================================= -->

    <a asp-controller="Workspace"
       asp-action="Details"
       asp-route-id="@Model.WorkspaceId"
       class="ws-boards-back-link">

        <span aria-hidden="true">←</span>

        <span>Back to workspace</span>

    </a>


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="ws-boards-header">

        <div class="ws-boards-header-copy">

            <p class="ws-boards-eyebrow">
                @Model.WorkspaceName / BOARDS
            </p>

            <h1>
                Boards
            </h1>

            <p>
                Organize your team's work into focused workflows
                and keep progress visible.
            </p>

        </div>


        @if (Model.CanManageBoards)
        {
            <a asp-controller="Board"
               asp-action="Create"
               asp-route-workspaceId="@Model.WorkspaceId"
               class="ws-boards-primary-action">

                <span aria-hidden="true">+</span>

                Create board

            </a>
        }

    </section>


    <!-- =========================================================
         SEARCH
         ========================================================= -->

    <section class="ws-boards-search-panel">

        <div class="ws-boards-search-copy">

            <span class="ws-boards-search-label">
                FIND A BOARD
            </span>

            <span>
                Search by board name or description.
            </span>

        </div>


        <form asp-controller="Board"
              asp-action="Index"
              asp-route-workspaceId="@Model.WorkspaceId"
              method="get"
              class="ws-boards-search-form">

            <div class="ws-boards-search-input-wrap">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="m16 16 4.5 4.5"></path>

                </svg>

                <input type="text"
                       name="search"
                       value="@search"
                       class="ws-boards-search-input"
                       placeholder="Search boards..."
                       aria-label="Search boards" />

            </div>


            <button type="submit"
                    class="ws-boards-search-button">

                Search

            </button>


            @if (hasSearch)
            {
                <a asp-controller="Board"
                   asp-action="Index"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   class="ws-boards-clear-button">

                    Clear

                </a>
            }

        </form>

    </section>


    <!-- =========================================================
         RESULT SUMMARY
         ========================================================= -->

    <div class="ws-boards-result-row">

        @if (hasSearch)
        {
            <p>
                Showing
                <strong>@boardCount</strong>
                @(boardCount == 1 ? "board" : "boards")
                matching
                <strong>“@search”</strong>
            </p>
        }
        else
        {
            <p>
                <strong>@boardCount</strong>
                @(boardCount == 1 ? "board" : "boards")
                in this workspace
            </p>
        }

    </div>


    <!-- =========================================================
         EMPTY STATE
         ========================================================= -->
    @if (boardCount == 0)
    {
        <section class="ws-boards-empty">

            <div class="ws-boards-empty-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">

                    <rect x="4" y="4" width="7" height="7" rx="1"></rect>
                    <rect x="13" y="4" width="7" height="4" rx="1"></rect>
                    <rect x="13" y="10" width="7" height="10" rx="1"></rect>
                    <rect x="4" y="13" width="7" height="7" rx="1"></rect>

                </svg>

            </div>


            @if (hasSearch)
            {
                <h2>
                    No boards found
                </h2>

                <p>
                    No boards match
                    <strong>“@search”</strong>.
                    Try another search term.
                </p>

                <a asp-controller="Board"
                   asp-action="Index"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   class="ws-boards-empty-secondary">

                    Clear search

                </a>
            }
            else
            {
                <h2>
                    No boards yet
                </h2>

                <p>
                    Create your first board to start organizing
                    work in this workspace.
                </p>

                @if (Model.CanManageBoards)
                {
                    <a asp-controller="Board"
                       asp-action="Create"
                       asp-route-workspaceId="@Model.WorkspaceId"
                       class="ws-boards-empty-primary">

                        Create your first board

                    </a>
                }
            }

        </section>
    }
    else
    {
        <!-- =====================================================
             BOARD GRID
             ===================================================== -->

        <section class="ws-board-grid"
                 aria-label="Workspace boards">

            @foreach (var board in Model.Boards)
            {
                var boardName =
                    board.Name?.Trim() ?? string.Empty;

                var boardInitial =
                    string.IsNullOrWhiteSpace(boardName)
                        ? "B"
                        : boardName
                            .Substring(0, 1)
                            .ToUpperInvariant();

                <article class="ws-board-card">

                    <!-- BOARD IDENTITY -->

                    <div class="ws-board-card-top">

                        <div class="ws-board-card-icon"
                             aria-hidden="true">

                            @boardInitial

                        </div>


                        <div class="ws-board-card-heading">

                            <span class="ws-board-card-label">
                                BOARD
                            </span>

                            <h2>
                                @board.Name
                            </h2>

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="ws-board-card-description">

                        @if (!string.IsNullOrWhiteSpace(board.Description))
                        {
                            <p>
                                @board.Description
                            </p>
                        }
                        else
                        {
                            <p class="is-muted">
                                No description has been added
                                for this board.
                            </p>
                        }

                    </div>


                    <!-- FOOTER -->

                    <div class="ws-board-card-footer">

                        <span class="ws-board-card-status">

                            <span aria-hidden="true"></span>

                            Active board

                        </span>


                        <a asp-controller="Board"
                           asp-action="Details"
                           asp-route-workspaceId="@Model.WorkspaceId"
                           asp-route-boardId="@board.Id"
                           class="ws-board-card-open">

                            Open board

                            <span aria-hidden="true">→</span>

                        </a>

                    </div>

                </article>
            }

        </section>
    }

</div>