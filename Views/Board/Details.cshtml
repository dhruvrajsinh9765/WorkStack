@model WorkStack.Models.ViewModels.BoardDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4">

    <!-- BOARD HEADER -->
    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>

            <div class="text-muted small mb-1">
                @Model.WorkspaceName
            </div>

            <h1 class="mb-2">
                @Model.Name
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted mb-2">
                    @Model.Description
                </p>
            }

            <div class="text-muted small">
                Created @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                ·
                Updated @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
            </div>

        </div>


        @if (Model.CanManageBoards)
        {
            <div class="d-flex gap-2">

                <a asp-controller="Board"
                   asp-action="Edit"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   asp-route-boardId="@Model.Id"
                   class="btn btn-primary">
                    Edit Board
                </a>


                <form asp-controller="Board"
                      asp-action="Delete"
                      asp-route-workspaceId="@Model.WorkspaceId"
                      asp-route-boardId="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this board?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Delete
                    </button>

                </form>


                <a asp-controller="Board"
                   asp-action="Index"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>
        }
        else
        {
            <a asp-controller="Board"
               asp-action="Index"
               asp-route-workspaceId="@Model.WorkspaceId"
               class="btn btn-secondary">
                Back
            </a>
        }

    </div>


    <!-- LIST HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h2 class="h4 mb-1">
                Lists
            </h2>

            <p class="text-muted mb-0">
                Organize tasks into workflow stages.
            </p>

        </div>


        @if (Model.CanManageLists)
        {
            <a asp-controller="List"
               asp-action="Create"
               asp-route-workspaceId="@Model.WorkspaceId"
               asp-route-boardId="@Model.Id"
               class="btn btn-primary">
                + Add List
            </a>
        }

    </div>


    <!-- KANBAN -->
    @if (Model.Lists.Count == 0)
    {
        <div class="card">

            <div class="card-body text-center py-5">

                <h3 class="h5">
                    No lists yet
                </h3>

                <p class="text-muted mb-0">
                    Create your first list to start adding tasks.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="d-flex gap-3 overflow-auto pb-3"
             style="align-items: flex-start;">

            @foreach (var list in Model.Lists)
            {
                <div class="card flex-shrink-0"
                     style="width: 330px;">

                    <!-- LIST HEADER -->
                    <div class="card-body pb-2">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <h3 class="h5 mb-1">
                                    @list.Name
                                </h3>

                                <div class="text-muted small">
                                    @list.TaskCount
                                    @(list.TaskCount == 1 ? "task" : "tasks")
                                </div>

                            </div>


                            @if (Model.CanManageLists)
                            {
                                <div class="dropdown">

                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <!-- MOVE LIST LEFT -->
                                        <li>

                                            <form asp-controller="List"
                                                  asp-action="MoveUp"
                                                  asp-route-workspaceId="@Model.WorkspaceId"
                                                  asp-route-boardId="@Model.Id"
                                                  asp-route-listId="@list.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">
                                                    Move Left
                                                </button>

                                            </form>

                                        </li>


                                        <!-- MOVE LIST RIGHT -->
                                        <li>

                                            <form asp-controller="List"
                                                  asp-action="MoveDown"
                                                  asp-route-workspaceId="@Model.WorkspaceId"
                                                  asp-route-boardId="@Model.Id"
                                                  asp-route-listId="@list.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item">
                                                    Move Right
                                                </button>

                                            </form>

                                        </li>


                                        <!-- EDIT LIST -->
                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="List"
                                               asp-action="Edit"
                                               asp-route-workspaceId="@Model.WorkspaceId"
                                               asp-route-boardId="@Model.Id"
                                               asp-route-listId="@list.Id">
                                                Edit List
                                            </a>

                                        </li>


                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>


                                        <!-- DELETE LIST -->
                                        <li>

                                            <form asp-controller="List"
                                                  asp-action="Delete"
                                                  asp-route-workspaceId="@Model.WorkspaceId"
                                                  asp-route-boardId="@Model.Id"
                                                  asp-route-listId="@list.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this list?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="dropdown-item text-danger">
                                                    Delete List
                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- TASKS -->
                    <div class="px-3 pb-3">

                        @if (list.Tasks.Count == 0)
                        {
                            <div class="border rounded p-4 text-center text-muted mb-3">
                                No tasks yet
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2 mb-3">

                                @foreach (var task in list.Tasks)
                                {
                                    <div class="border rounded p-3">

                                        <!-- TASK TITLE -->
                                        <a asp-controller="Task"
                                           asp-action="Details"
                                           asp-route-workspaceId="@Model.WorkspaceId"
                                           asp-route-boardId="@Model.Id"
                                           asp-route-listId="@list.Id"
                                           asp-route-taskId="@task.Id"
                                           class="text-decoration-none">

                                            <div class="d-flex justify-content-between align-items-start gap-2">

                                                <div class="fw-semibold">
                                                    @task.Title
                                                </div>


                                                <span class="badge
                                                    @(task.Priority == WorkStack.Models.Enums.TaskPriority.Urgent
                                                          ? "bg-danger"
                                                          : task.Priority == WorkStack.Models.Enums.TaskPriority.High
                                                              ? "bg-warning text-dark"
                                                              : task.Priority == WorkStack.Models.Enums.TaskPriority.Medium
                                                                  ? "bg-primary"
                                                                  : "bg-secondary")">

                                                    @task.Priority

                                                </span>

                                            </div>


                                            @if (task.DueDate.HasValue)
                                            {
                                                <div class="text-muted small mt-2">
                                                    Due @task.DueDate.Value.ToString("dd MMM yyyy")
                                                </div>
                                            }


                                            @if (task.AssigneeNames.Count > 0)
                                            {
                                                <div class="text-muted small mt-2">

                                                    <strong>Assigned:</strong>

                                                    @string.Join(", ", task.AssigneeNames)

                                                </div>
                                            }

                                        </a>


                                        <!-- MOVE TASK -->
                                        @if (Model.CanManageLists && Model.Lists.Count > 1)
                                        {
                                            <div class="mt-3">

                                                <form asp-controller="Task"
                                                      asp-action="Move"
                                                      asp-route-workspaceId="@Model.WorkspaceId"
                                                      asp-route-boardId="@Model.Id"
                                                      asp-route-listId="@list.Id"
                                                      asp-route-taskId="@task.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <label class="form-label small text-muted mb-1">
                                                        Move to
                                                    </label>

                                                    <div class="input-group input-group-sm">

                                                        <select name="targetListId"
                                                                class="form-select">

                                                            @foreach (var targetList in Model.Lists)
                                                            {
                                                                if (targetList.Id != list.Id)
                                                                {
                                                                    <option value="@targetList.Id">
                                                                        @targetList.Name
                                                                    </option>
                                                                }
                                                            }

                                                        </select>


                                                        <button type="submit"
                                                                class="btn btn-outline-primary">
                                                            Move
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>
                                        }

                                    </div>
                                }

                            </div>
                        }


                        <!-- ADD TASK -->
                        @if (Model.CanManageLists)
                        {
                            <a asp-controller="Task"
                               asp-action="Create"
                               asp-route-workspaceId="@Model.WorkspaceId"
                               asp-route-boardId="@Model.Id"
                               asp-route-listId="@list.Id"
                               class="btn btn-sm btn-outline-primary w-100">
                                + Add Task
                            </a>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>