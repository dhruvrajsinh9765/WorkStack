@model WorkStack.Models.ViewModels.BoardDetailsViewModel

@{
    ViewData["Title"] = Model.Name;

    var search = Model.Search?.Trim() ?? string.Empty;
    var priority = Model.Priority?.Trim() ?? string.Empty;

    var hasSearch = !string.IsNullOrWhiteSpace(search);
    var hasPriority = !string.IsNullOrWhiteSpace(priority);
    var hasFilters = hasSearch || hasPriority;

    var totalTasks = Model.Lists.Sum(list => list.TaskCount);
    var visibleTasks = Model.Lists.Sum(list => list.Tasks.Count);

    var boardName =
        Model.Name?.Trim() ?? string.Empty;

    var boardInitial =
        string.IsNullOrWhiteSpace(boardName)
            ? "B"
            : boardName
                .Substring(0, 1)
                .ToUpperInvariant();
}

<div class="ws-board-details-page">

    <!-- =========================================================
         BACK NAVIGATION
         ========================================================= -->

    <a asp-controller="Board"
       asp-action="Index"
       asp-route-workspaceId="@Model.WorkspaceId"
       class="ws-board-details-back">

        <span aria-hidden="true">←</span>

        <span>
            @Model.WorkspaceName / Boards
        </span>

    </a>


    <!-- =========================================================
         BOARD HEADER
         ========================================================= -->

    <section class="ws-board-hero">

        <div class="ws-board-hero-main">

            <div class="ws-board-hero-icon"
                 aria-hidden="true">

                @boardInitial

            </div>


            <div class="ws-board-hero-copy">

                <p class="ws-board-hero-eyebrow">
                    BOARD
                </p>

                <h1>
                    @Model.Name
                </h1>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="ws-board-hero-description">
                        @Model.Description
                    </p>
                }

                <div class="ws-board-meta">

                    <span>
                        Created
                        @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </span>

                    <span class="ws-board-meta-divider"
                          aria-hidden="true">
                        /
                    </span>

                    <span>
                        Updated
                        @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </span>

                    <span class="ws-board-meta-divider"
                          aria-hidden="true">
                        /
                    </span>

                    <span>
                        @totalTasks
                        @(totalTasks == 1 ? "task" : "tasks")
                    </span>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="ws-board-hero-actions">

            @if (Model.CanManageBoards)
            {
                <a asp-controller="Board"
                   asp-action="Edit"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   asp-route-boardId="@Model.Id"
                   class="ws-board-secondary-action">

                    Edit board

                </a>

                <form asp-controller="Board"
                      asp-action="Delete"
                      asp-route-workspaceId="@Model.WorkspaceId"
                      asp-route-boardId="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this board?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="ws-board-danger-action">

                        Delete

                    </button>

                </form>
            }

        </div>

    </section>


    <!-- =========================================================
         DELETE ERROR
         ========================================================= -->
    @if (TempData["BoardDeleteError"] is string boardDeleteError)
    {
        <div class="ws-board-alert"
             role="alert">

            <div class="ws-board-alert-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">

                    <path d="M12 4 3.8 19h16.4z"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 16.5h.01"></path>

                </svg>

            </div>

            <div>

                <strong>
                    Board could not be deleted
                </strong>

                <p>
                    @boardDeleteError
                </p>

            </div>

        </div>
    }


    <!-- =========================================================
         FILTER BAR
         ========================================================= -->

    <section class="ws-board-filter-panel">

        <div class="ws-board-filter-heading">

            <div>

                <span class="ws-board-filter-eyebrow">
                    BOARD VIEW
                </span>

                <h2>
                    Workflow
                </h2>

            </div>

            <span class="ws-board-filter-task-count">

                @if (hasFilters)
                {
                    @visibleTasks
                    <span>visible</span>
                }
                else
                {
                    @totalTasks
                    <span>tasks</span>
                }

            </span>

        </div>


        <form asp-controller="Board"
              asp-action="Details"
              asp-route-workspaceId="@Model.WorkspaceId"
              asp-route-boardId="@Model.Id"
              method="get"
              class="ws-board-filter-form">

            <!-- SEARCH -->

            <div class="ws-board-filter-search">

                <svg viewBox="0 0 24 24"
                     aria-hidden="true">

                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="m16 16 4.5 4.5"></path>

                </svg>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search tasks by title..."
                       aria-label="Search tasks" />

            </div>


            <!-- PRIORITY -->

            <div class="ws-board-filter-priority">

                <select name="priority"
                        aria-label="Filter by priority">

                    <option value="">
                        All priorities
                    </option>

                    @foreach (
                        var taskPriority
                        in Enum.GetValues<WorkStack.Models.Enums.TaskPriority>())
                    {
                        if (string.Equals(
                            priority,
                            taskPriority.ToString(),
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@taskPriority"
                                    selected>
                                @taskPriority
                            </option>
                        }
                        else
                        {
                            <option value="@taskPriority">
                                @taskPriority
                            </option>
                        }
                    }

                </select>

            </div>


            <button type="submit"
                    class="ws-board-filter-apply">

                Apply filters

            </button>


            @if (hasFilters)
            {
                <a asp-controller="Board"
                   asp-action="Details"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   asp-route-boardId="@Model.Id"
                   class="ws-board-filter-clear">

                    Clear

                </a>
            }

        </form>


        @if (hasFilters)
        {
            <div class="ws-board-active-filters">

                <span>
                    Active filters:
                </span>

                @if (hasSearch)
                {
                    <span class="ws-board-filter-chip">

                        Search:
                        <strong>@search</strong>

                    </span>
                }

                @if (hasPriority)
                {
                    <span class="ws-board-filter-chip">

                        Priority:
                        <strong>@priority</strong>

                    </span>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         LIST HEADER
         ========================================================= -->

    <section class="ws-board-workflow-header">

        <div>

            <span class="ws-board-section-eyebrow">
                KANBAN WORKFLOW
            </span>

            <h2>
                Lists
            </h2>

            <p>
                Move work through your team's workflow stages.
            </p>

        </div>


        @if (Model.CanManageLists)
        {
            <a asp-controller="List"
               asp-action="Create"
               asp-route-workspaceId="@Model.WorkspaceId"
               asp-route-boardId="@Model.Id"
               class="ws-board-add-list">

                <span aria-hidden="true">+</span>

                Add list

            </a>
        }

    </section>


    <!-- =========================================================
         NO LISTS
         ========================================================= -->
    @if (Model.Lists.Count == 0)
    {
        <section class="ws-board-empty">

            <div class="ws-board-empty-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">

                    <rect x="4" y="5" width="5" height="14" rx="1"></rect>
                    <rect x="11" y="5" width="5" height="10" rx="1"></rect>
                    <rect x="18" y="5" width="2" height="7" rx="1"></rect>

                </svg>

            </div>

            <h3>
                No lists yet
            </h3>

            <p>
                Create your first workflow stage to start
                organizing tasks on this board.
            </p>

            @if (Model.CanManageLists)
            {
                <a asp-controller="List"
                   asp-action="Create"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   asp-route-boardId="@Model.Id"
                   class="ws-board-empty-primary">

                    Create first list

                </a>
            }

        </section>
    }
    else
    {
        <!-- =====================================================
             KANBAN
             ===================================================== -->

        <section class="ws-kanban"
                 aria-label="Board workflow">

            @foreach (var list in Model.Lists)
            {
                <article class="ws-kanban-column">

                    <!-- COLUMN HEADER -->

                    <header class="ws-kanban-column-header">

                        <div>

                            <h3>
                                @list.Name
                            </h3>

                            <span>
                                @list.TaskCount
                                @(list.TaskCount == 1
                                    ? "task"
                                    : "tasks")
                            </span>

                        </div>


                        @if (Model.CanManageLists)
                        {
                            <div class="dropdown">

                                <button class="ws-kanban-menu-button"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="List actions">

                                    <span></span>
                                    <span></span>
                                    <span></span>

                                </button>


                                <ul class="dropdown-menu dropdown-menu-end ws-kanban-dropdown">

                                    <li>

                                        <form asp-controller="List"
                                              asp-action="MoveUp"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.Id"
                                              asp-route-listId="@list.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item">

                                                Move left

                                            </button>

                                        </form>

                                    </li>


                                    <li>

                                        <form asp-controller="List"
                                              asp-action="MoveDown"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.Id"
                                              asp-route-listId="@list.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item">

                                                Move right

                                            </button>

                                        </form>

                                    </li>


                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="List"
                                           asp-action="Edit"
                                           asp-route-workspaceId="@Model.WorkspaceId"
                                           asp-route-boardId="@Model.Id"
                                           asp-route-listId="@list.Id">

                                            Edit list

                                        </a>

                                    </li>


                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <li>

                                        <form asp-controller="List"
                                              asp-action="Delete"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.Id"
                                              asp-route-listId="@list.Id"
                                              method="post"
                                              onsubmit="return confirm('Delete this list?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="dropdown-item text-danger">

                                                Delete list

                                            </button>

                                        </form>

                                    </li>

                                </ul>

                            </div>
                        }

                    </header>


                    <!-- COLUMN BODY -->

                    <div class="ws-kanban-column-body">

                        @if (list.Tasks.Count == 0)
                        {
                            <div class="ws-kanban-empty">

                                @if (hasFilters && list.TaskCount > 0)
                                {
                                    <span>
                                        No matching tasks
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        No tasks yet
                                    </span>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="ws-kanban-tasks">

                                @foreach (var task in list.Tasks)
                                {
                                    var priorityClass =
                                        task.Priority switch
                                        {
                                            WorkStack.Models.Enums.TaskPriority.Urgent
                                                => "ws-task-priority-urgent",

                                            WorkStack.Models.Enums.TaskPriority.High
                                                => "ws-task-priority-high",

                                            WorkStack.Models.Enums.TaskPriority.Medium
                                                => "ws-task-priority-medium",

                                            _
                                                => "ws-task-priority-low"
                                        };

                                    <article class="ws-kanban-task">

                                        <a asp-controller="Task"
                                           asp-action="Details"
                                           asp-route-workspaceId="@Model.WorkspaceId"
                                           asp-route-boardId="@Model.Id"
                                           asp-route-listId="@list.Id"
                                           asp-route-taskId="@task.Id"
                                           class="ws-kanban-task-link">

                                            <div class="ws-kanban-task-top">

                                                <span class="ws-task-priority @priorityClass">
                                                    @task.Priority
                                                </span>

                                            </div>


                                            <h4>
                                                @task.Title
                                            </h4>


                                            @if (task.DueDate.HasValue)
                                            {
                                                <div class="ws-kanban-task-due">

                                                    <svg viewBox="0 0 24 24"
                                                         aria-hidden="true">

                                                        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                                        <path d="M8 3v4M16 3v4M4 10h16"></path>

                                                    </svg>

                                                    <span>
                                                        Due
                                                        @task.DueDate.Value.ToString("dd MMM yyyy")
                                                    </span>

                                                </div>
                                            }


                                            @if (task.AssigneeNames.Count > 0)
                                            {
                                                <div class="ws-kanban-task-assignees">

                                                    <div class="ws-kanban-assignee-stack">

                                                        @foreach (
                                                            var assigneeName
                                                            in task.AssigneeNames.Take(3))
                                                        {
                                                            var assigneeInitial =
                                                                string.IsNullOrWhiteSpace(assigneeName)
                                                                    ? "?"
                                                                    : assigneeName
                                                                        .Trim()
                                                                        .Substring(0, 1)
                                                                        .ToUpperInvariant();

                                                            <span class="ws-kanban-assignee-avatar"
                                                                  title="@assigneeName">

                                                                @assigneeInitial

                                                            </span>
                                                        }

                                                    </div>


                                                    <span>
                                                        @task.AssigneeNames.Count
                                                        @(task.AssigneeNames.Count == 1
                                                            ? "assignee"
                                                            : "assignees")
                                                    </span>

                                                </div>
                                            }

                                        </a>


                                        <!-- MOVE TASK -->
                                        @if (Model.CanManageLists &&
                                                                                     Model.Lists.Count > 1)
                                        {
                                            <div class="ws-kanban-move">

                                                <form asp-controller="Task"
                                                      asp-action="Move"
                                                      asp-route-workspaceId="@Model.WorkspaceId"
                                                      asp-route-boardId="@Model.Id"
                                                      asp-route-listId="@list.Id"
                                                      asp-route-taskId="@task.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <select name="targetListId"
                                                            aria-label="Move task to another list">

                                                        @foreach (
                                                            var targetList
                                                            in Model.Lists)
                                                        {
                                                            if (targetList.Id != list.Id)
                                                            {
                                                                <option value="@targetList.Id">
                                                                    Move to @targetList.Name
                                                                </option>
                                                            }
                                                        }

                                                    </select>

                                                    <button type="submit">
                                                        Move
                                                    </button>

                                                </form>

                                            </div>
                                        }

                                    </article>
                                }

                            </div>
                        }


                        <!-- ADD TASK -->
                        @if (Model.CanManageLists)
                        {
                            <a asp-controller="Task"
                               asp-action="Create"
                               asp-route-workspaceId="@Model.WorkspaceId"
                               asp-route-boardId="@Model.Id"
                               asp-route-listId="@list.Id"
                               class="ws-kanban-add-task">

                                <span aria-hidden="true">+</span>

                                Add task

                            </a>
                        }

                    </div>

                </article>
            }

        </section>
    }

</div>