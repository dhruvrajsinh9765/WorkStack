@model WorkStack.Models.ViewModels.BoardFormViewModel

@{
    ViewData["Title"] = "Edit board";

    var workspaceId = (int)ViewData["WorkspaceId"]!;
    var boardId = (int)ViewData["BoardId"]!;
}

<div class="ws-board-form-page">

    <a asp-controller="Board"
       asp-action="Details"
       asp-route-workspaceId="@workspaceId"
       asp-route-boardId="@boardId"
       class="ws-board-form-back">

        <span aria-hidden="true">←</span>

        <span>Back to board</span>

    </a>


    <div class="ws-board-form-layout">

        <section class="ws-board-form-intro">

            <div class="ws-board-form-icon"
                 aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <path d="M4 20h4L19 9l-4-4L4 16z"></path>
                    <path d="m13.5 6.5 4 4"></path>
                </svg>

            </div>

            <p class="ws-board-form-eyebrow">
                BOARD SETTINGS
            </p>

            <h1>
                Edit board
            </h1>

            <p>
                Update the board name or description to keep
                your team's workspace clear and organized.
            </p>

            <div class="ws-board-form-context">

                <span class="ws-board-form-context-label">
                    BOARD
                </span>

                <span>
                    Changes will be applied to this board immediately.
                </span>

            </div>

        </section>


        <section class="ws-board-form-card">

            <div class="ws-board-form-card-header">

                <div>
                    <span class="ws-board-form-card-label">
                        BOARD DETAILS
                    </span>

                    <h2>
                        Update your board
                    </h2>

                    <p>
                        Change the information your team sees on the board.
                    </p>
                </div>

            </div>


            <form asp-controller="Board"
                  asp-action="Edit"
                  asp-route-workspaceId="@workspaceId"
                  asp-route-boardId="@boardId"
                  method="post"
                  class="ws-board-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="ws-board-validation-summary"
                     role="alert">
                </div>


                <div class="ws-board-form-field">

                    <label asp-for="Name"
                           class="ws-board-form-label">
                    </label>

                    <input asp-for="Name"
                           class="ws-board-form-input"
                           placeholder="e.g. Product Development"
                           maxlength="100"
                           autocomplete="off"
                           autofocus />

                    <span asp-validation-for="Name"
                          class="ws-board-form-error">
                    </span>

                    <span class="ws-board-form-hint">
                        Use a clear name that your team can recognize quickly.
                    </span>

                </div>


                <div class="ws-board-form-field">

                    <label asp-for="Description"
                           class="ws-board-form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="ws-board-form-input ws-board-form-textarea"
                              rows="5"
                              maxlength="500"
                              placeholder="Describe what this board is used for."></textarea>

                    <span asp-validation-for="Description"
                          class="ws-board-form-error">
                    </span>

                    <span class="ws-board-form-hint">
                        Keep the description useful and concise.
                    </span>

                </div>


                <div class="ws-board-form-actions">

                    <a asp-controller="Board"
                       asp-action="Details"
                       asp-route-workspaceId="@workspaceId"
                       asp-route-boardId="@boardId"
                       class="ws-board-form-cancel">

                        Cancel

                    </a>

                    <button type="submit"
                            class="ws-board-form-submit">

                        Save changes

                        <span aria-hidden="true">→</span>

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}