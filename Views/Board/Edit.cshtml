@model WorkStack.Models.ViewModels.BoardFormViewModel

@{
    ViewData["Title"] = "Edit board";
    var workspaceId = (int)ViewData["WorkspaceId"]!;
    var boardId = (int)ViewData["BoardId"]!;
}

<h1>Edit board</h1>

<form asp-action="Edit" asp-route-workspaceId="@workspaceId" asp-route-boardId="@boardId" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-workspaceId="@workspaceId" asp-route-boardId="@boardId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
