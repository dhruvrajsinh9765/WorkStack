@model WorkStack.Models.ViewModels.EditTaskViewModel

@{
    ViewData["Title"] = "Edit Task";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <div class="text-muted small mb-1">Task</div>

        <h1 class="mb-2">
            Edit Task
        </h1>

        <p class="text-muted mb-0">
            Update the task details and save your changes.
        </p>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-controller="Task"
                  asp-action="Edit"
                  asp-route-workspaceId="@Model.WorkspaceId"
                  asp-route-boardId="@Model.BoardId"
                  asp-route-listId="@Model.ListId"
                  asp-route-taskId="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>


                <!-- Title -->
                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                        Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           maxlength="200"
                           placeholder="Enter task title" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="6"
                              maxlength="5000"
                              placeholder="Describe the task..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>

                </div>


                <!-- Priority + Due Date -->
                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Priority"
                               class="form-label">
                            Priority
                        </label>

                        <select asp-for="Priority"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<WorkStack.Models.Enums.TaskPriority>()">
                        </select>

                        <span asp-validation-for="Priority"
                              class="text-danger"></span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="DueDate"
                               class="form-label">
                            Due Date
                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DueDate"
                              class="text-danger"></span>

                    </div>

                </div>


                <!-- Actions -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>


                    <a asp-controller="Task"
                       asp-action="Details"
                       asp-route-workspaceId="@Model.WorkspaceId"
                       asp-route-boardId="@Model.BoardId"
                       asp-route-listId="@Model.ListId"
                       asp-route-taskId="@Model.Id"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}