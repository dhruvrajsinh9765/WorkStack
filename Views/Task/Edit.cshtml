@model WorkStack.Models.ViewModels.EditTaskViewModel

@{
    ViewData["Title"] = "Edit Task";
}

<div class="ws-task-form-page">

    <a asp-controller="Task"
       asp-action="Details"
       asp-route-workspaceId="@Model.WorkspaceId"
       asp-route-boardId="@Model.BoardId"
       asp-route-listId="@Model.ListId"
       asp-route-taskId="@Model.Id"
       class="ws-task-form-back">

        <span aria-hidden="true">←</span>
        <span>Back to task</span>

    </a>


    <div class="ws-task-form-layout">

        <!-- INTRO -->

        <section class="ws-task-form-intro">

            <div class="ws-task-form-icon" aria-hidden="true">

                <svg viewBox="0 0 24 24">
                    <path d="M4 20h4L19 9l-4-4L4 16z"></path>
                    <path d="m13.5 6.5 4 4"></path>
                </svg>

            </div>

            <p class="ws-task-form-eyebrow">
                TASK SETTINGS
            </p>

            <h1>
                Edit task
            </h1>

            <p>
                Update the task details, priority, or due date
                to keep your team's work accurate.
            </p>

            <div class="ws-task-form-context">

                <span class="ws-task-form-context-label">
                    TASK
                </span>

                <strong>
                    @Model.Title
                </strong>

            </div>

        </section>


        <!-- FORM -->

        <section class="ws-task-form-card">

            <div class="ws-task-form-card-header">

                <div>

                    <span class="ws-task-form-card-label">
                        TASK DETAILS
                    </span>

                    <h2>
                        Update the work
                    </h2>

                    <p>
                        Make your changes and save when you're ready.
                    </p>

                </div>

            </div>


            <form asp-controller="Task"
                  asp-action="Edit"
                  asp-route-workspaceId="@Model.WorkspaceId"
                  asp-route-boardId="@Model.BoardId"
                  asp-route-listId="@Model.ListId"
                  asp-route-taskId="@Model.Id"
                  method="post"
                  class="ws-task-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="ws-task-validation-summary"
                     role="alert">
                </div>


                <!-- TITLE -->

                <div class="ws-task-form-field">

                    <label asp-for="Title"
                           class="ws-task-form-label">
                    </label>

                    <input asp-for="Title"
                           class="ws-task-form-input"
                           maxlength="200"
                           placeholder="Task title"
                           autocomplete="off"
                           autofocus />

                    <span asp-validation-for="Title"
                          class="ws-task-form-error">
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="ws-task-form-field">

                    <label asp-for="Description"
                           class="ws-task-form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="ws-task-form-input ws-task-form-textarea"
                              rows="6"
                              maxlength="5000"
                              placeholder="Describe the task..."></textarea>

                    <span asp-validation-for="Description"
                          class="ws-task-form-error">
                    </span>

                </div>


                <!-- PRIORITY / DATE -->

                <div class="ws-task-form-grid">

                    <div class="ws-task-form-field">

                        <label asp-for="Priority"
                               class="ws-task-form-label">
                        </label>

                        <select asp-for="Priority"
                                class="ws-task-form-input ws-task-form-select"
                                asp-items="Html.GetEnumSelectList<WorkStack.Models.Enums.TaskPriority>()">
                        </select>

                        <span asp-validation-for="Priority"
                              class="ws-task-form-error">
                        </span>

                    </div>


                    <div class="ws-task-form-field">

                        <label asp-for="DueDate"
                               class="ws-task-form-label">
                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="ws-task-form-input" />

                        <span asp-validation-for="DueDate"
                              class="ws-task-form-error">
                        </span>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="ws-task-form-actions">

                    <a asp-controller="Task"
                       asp-action="Details"
                       asp-route-workspaceId="@Model.WorkspaceId"
                       asp-route-boardId="@Model.BoardId"
                       asp-route-listId="@Model.ListId"
                       asp-route-taskId="@Model.Id"
                       class="ws-task-form-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="ws-task-form-submit">

                        Save changes
                        <span aria-hidden="true">→</span>

                    </button>

                </div>

            </form>

        </section>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}