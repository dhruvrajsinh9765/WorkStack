@model WorkStack.Models.ViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="ws-task-details-page">

    <!-- BACK -->

    <a asp-controller="Board"
       asp-action="Details"
       asp-route-workspaceId="@Model.WorkspaceId"
       asp-route-boardId="@Model.BoardId"
       class="ws-task-details-back">

        <span aria-hidden="true">←</span>
        <span>Back to board</span>

    </a>


    <!-- TASK HERO -->

    <section class="ws-task-hero">

        <div class="ws-task-hero-main">

            <div class="ws-task-hero-eyebrow">
                @Model.ListName
            </div>

            <h1>
                @Model.Title
            </h1>

            <div class="ws-task-hero-meta">

                <span class="ws-task-priority
                    @(Model.Priority switch
                      {
                          WorkStack.Models.Enums.TaskPriority.Urgent => "is-urgent",
                          WorkStack.Models.Enums.TaskPriority.High => "is-high",
                          WorkStack.Models.Enums.TaskPriority.Medium => "is-medium",
                          _ => "is-low"
                      })">

                    <span class="ws-task-priority-dot"></span>

                    @Model.Priority

                </span>


                @if (Model.DueDate.HasValue)
                {
                    <span class="ws-task-date-badge">

                        <span aria-hidden="true">◷</span>

                        Due @Model.DueDate.Value.ToString("dd MMM yyyy")

                    </span>
                }
                else
                {
                    <span class="ws-task-date-badge is-muted">
                        No due date
                    </span>
                }

            </div>

        </div>


        @if (Model.CanManage)
        {
            <div class="ws-task-hero-actions">

                <!-- EDIT -->

                <a asp-controller="Task"
                   asp-action="Edit"
                   asp-route-workspaceId="@Model.WorkspaceId"
                   asp-route-boardId="@Model.BoardId"
                   asp-route-listId="@Model.ListId"
                   asp-route-taskId="@Model.Id"
                   class="ws-task-action-primary">

                    Edit task

                </a>


                <!-- DELETE -->

                <form asp-controller="Task"
                      asp-action="Delete"
                      asp-route-workspaceId="@Model.WorkspaceId"
                      asp-route-boardId="@Model.BoardId"
                      asp-route-listId="@Model.ListId"
                      asp-route-taskId="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this task?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="ws-task-action-danger">

                        Delete

                    </button>

                </form>

            </div>
        }

    </section>


    <!-- MAIN CONTENT -->

    <div class="ws-task-details-grid">

        <!-- LEFT -->

        <main class="ws-task-details-main">


            <!-- DESCRIPTION -->

            <section class="ws-task-panel">

                <div class="ws-task-panel-header">

                    <div>

                        <span class="ws-task-panel-eyebrow">
                            DETAILS
                        </span>

                        <h2>
                            Description
                        </h2>

                    </div>

                </div>


                <div class="ws-task-description">

                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="ws-task-empty-text">
                            No description has been added to this task.
                        </p>
                    }
                    else
                    {
                        @Model.Description
                    }

                </div>

            </section>


            <!-- COMMENTS -->

            <section class="ws-task-panel">

                <div class="ws-task-panel-header">

                    <div>

                        <span class="ws-task-panel-eyebrow">
                            COLLABORATION
                        </span>

                        <h2>
                            Comments
                        </h2>

                    </div>

                    <span class="ws-task-count">
                        @Model.Comments.Count
                    </span>

                </div>


                @if (TempData["CommentError"] != null)
                {
                    <div class="ws-task-inline-error"
                         role="alert">

                        @TempData["CommentError"]

                    </div>
                }


                <!-- ADD COMMENT -->

                <form asp-controller="Task"
                      asp-action="AddComment"
                      asp-route-workspaceId="@Model.WorkspaceId"
                      asp-route-boardId="@Model.BoardId"
                      asp-route-listId="@Model.ListId"
                      asp-route-taskId="@Model.Id"
                      method="post"
                      class="ws-task-comment-form">

                    @Html.AntiForgeryToken()

                    <textarea name="content"
                              rows="4"
                              maxlength="2000"
                              class="ws-task-comment-input"
                              placeholder="Write a comment for your team..."></textarea>


                    <div class="ws-task-comment-footer">

                        <span>
                            Share an update, question, or useful context.
                        </span>

                        <button type="submit"
                                class="ws-task-comment-submit">

                            Add comment

                        </button>

                    </div>

                </form>


                <!-- COMMENTS LIST -->
                @if (Model.Comments.Count == 0)
                {
                    <div class="ws-task-comments-empty">

                        <div class="ws-task-empty-icon">
                            💬
                        </div>

                        <strong>
                            No comments yet
                        </strong>

                        <span>
                            Start the conversation on this task.
                        </span>

                    </div>
                }
                else
                {
                    <div class="ws-task-comments-list">

                        @foreach (var comment in Model.Comments)
                        {
                            var commentName =
                                comment.UserName?.Trim() ?? string.Empty;

                            var commentInitial =
                                string.IsNullOrWhiteSpace(commentName)
                                    ? "?"
                                    : commentName
                                        .Substring(0, 1)
                                        .ToUpperInvariant();


                            <article class="ws-task-comment">

                                <div class="ws-task-comment-avatar">
                                    @commentInitial
                                </div>


                                <div class="ws-task-comment-body">

                                    <div class="ws-task-comment-top">

                                        <div>

                                            <strong>
                                                @comment.UserName
                                            </strong>

                                            <time>
                                                @comment.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy, hh:mm tt")
                                            </time>

                                        </div>


                                        <!-- DELETE COMMENT -->

                                        <form asp-controller="Task"
                                              asp-action="DeleteComment"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.BoardId"
                                              asp-route-listId="@Model.ListId"
                                              asp-route-taskId="@Model.Id"
                                              asp-route-commentId="@comment.Id"
                                              method="post"
                                              class="ws-task-comment-delete-form"
                                              onsubmit="return confirm('Delete this comment?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit">
                                                Delete
                                            </button>

                                        </form>

                                    </div>


                                    <div class="ws-task-comment-content">
                                        @comment.Content
                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }

            </section>

        </main>


        <!-- RIGHT -->

        <aside class="ws-task-details-sidebar">


            <!-- TASK INFORMATION -->

            <section class="ws-task-panel">

                <div class="ws-task-panel-header">

                    <div>

                        <span class="ws-task-panel-eyebrow">
                            OVERVIEW
                        </span>

                        <h2>
                            Task information
                        </h2>

                    </div>

                </div>


                <div class="ws-task-info-list">

                    <div class="ws-task-info-row">

                        <span>
                            Created by
                        </span>

                        <strong>
                            @Model.CreatorName
                        </strong>

                    </div>


                    <div class="ws-task-info-row">

                        <span>
                            Created
                        </span>

                        <strong>
                            @Model.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                        </strong>

                    </div>


                    <div class="ws-task-info-row">

                        <span>
                            Last updated
                        </span>

                        <strong>
                            @Model.UpdatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                        </strong>

                    </div>

                </div>

            </section>


            <!-- ASSIGNEES -->

            <section class="ws-task-panel">

                <div class="ws-task-panel-header">

                    <div>

                        <span class="ws-task-panel-eyebrow">
                            PEOPLE
                        </span>

                        <h2>
                            Assignees
                        </h2>

                    </div>

                    <span class="ws-task-count">
                        @Model.Assignees.Count
                    </span>

                </div>


                @if (Model.Assignees.Count == 0)
                {
                    <div class="ws-task-sidebar-empty">
                        No one is assigned to this task.
                    </div>
                }
                else
                {
                    <div class="ws-task-assigned-list">

                        @foreach (var assignee in Model.Assignees)
                        {
                            var assigneeName =
                                assignee.UserName?.Trim() ?? string.Empty;

                            var assigneeInitial =
                                string.IsNullOrWhiteSpace(assigneeName)
                                    ? "?"
                                    : assigneeName
                                        .Substring(0, 1)
                                        .ToUpperInvariant();


                            <div class="ws-task-assignee-row">

                                <div class="ws-task-assignee-person">

                                    <span class="ws-task-assignee-avatar">
                                        @assigneeInitial
                                    </span>

                                    <span>
                                        @assignee.UserName
                                    </span>

                                </div>


                                @if (Model.CanManage)
                                {
                                    <!-- UNASSIGN -->

                                    <form asp-controller="Task"
                                          asp-action="Unassign"
                                          asp-route-workspaceId="@Model.WorkspaceId"
                                          asp-route-boardId="@Model.BoardId"
                                          asp-route-listId="@Model.ListId"
                                          asp-route-taskId="@Model.Id"
                                          asp-route-userId="@assignee.UserId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="ws-task-remove-button">

                                            Remove

                                        </button>

                                    </form>
                                }

                            </div>
                        }

                    </div>
                }


                @if (Model.CanManage)
                {
                    <div class="ws-task-assign-section">

                        <div class="ws-task-assign-title">
                            Assign member
                        </div>


                        <!-- ASSIGN -->

                        <form asp-controller="Task"
                              asp-action="Assign"
                              asp-route-workspaceId="@Model.WorkspaceId"
                              asp-route-boardId="@Model.BoardId"
                              asp-route-listId="@Model.ListId"
                              asp-route-taskId="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <select name="userId"
                                    class="ws-task-assign-select">

                                <option value="">
                                    Select member
                                </option>

                                @foreach (var member in Model.WorkspaceMembers)
                                {
                                    if (!Model.Assignees.Any(
                                        a => a.UserId == member.UserId))
                                    {
                                        <option value="@member.UserId">
                                            @member.UserName
                                        </option>
                                    }
                                }

                            </select>


                            <button type="submit"
                                    class="ws-task-assign-button">

                                Assign member

                            </button>

                        </form>

                    </div>
                }

            </section>

        </aside>

    </div>

</div>