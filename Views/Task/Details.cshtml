@model WorkStack.Models.ViewModels.TaskDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid py-4">

    <!-- Back to Board -->
    <div class="mb-3">
        <a asp-controller="Board"
           asp-action="Details"
           asp-route-workspaceId="@Model.WorkspaceId"
           asp-route-id="@Model.BoardId"
           class="btn btn-outline-secondary btn-sm">
            ← Back to Board
        </a>
    </div>


    <!-- =========================================================
         TASK HEADER
         ========================================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">

                <div>

                    <div class="text-muted small mb-1">
                        @Model.ListName
                    </div>

                    <h2 class="fw-bold mb-2">
                        @Model.Title
                    </h2>

                    <div class="d-flex flex-wrap gap-2">

                        <span class="badge
                            @(Model.Priority switch
                              {
                                  WorkStack.Models.Enums.TaskPriority.Urgent => "bg-danger",
                                  WorkStack.Models.Enums.TaskPriority.High => "bg-warning text-dark",
                                  WorkStack.Models.Enums.TaskPriority.Medium => "bg-primary",
                                  _ => "bg-secondary"
                              })">
                            @Model.Priority
                        </span>


                        @if (Model.DueDate.HasValue)
                        {
                            <span class="badge bg-light text-dark border">
                                Due: @Model.DueDate.Value.ToLocalTime().ToString("dd MMM yyyy")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border">
                                No due date
                            </span>
                        }

                    </div>

                </div>


                <!-- Task Actions -->
                @if (Model.CanManage)
                {
                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Task"
                           asp-action="Edit"
                           asp-route-workspaceId="@Model.WorkspaceId"
                           asp-route-boardId="@Model.BoardId"
                           asp-route-listId="@Model.ListId"
                           asp-route-taskId="@Model.Id"
                           class="btn btn-primary">
                            Edit Task
                        </a>


                        <form asp-controller="Task"
                              asp-action="Delete"
                              asp-route-workspaceId="@Model.WorkspaceId"
                              asp-route-boardId="@Model.BoardId"
                              asp-route-listId="@Model.ListId"
                              asp-route-taskId="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this task?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Delete
                            </button>

                        </form>

                    </div>
                }

            </div>

        </div>

    </div>



    <div class="row g-4">

        <!-- =====================================================
             LEFT COLUMN
             ===================================================== -->

        <div class="col-lg-8">


            <!-- Description -->
            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Description
                    </h5>


                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">
                            No description has been added.
                        </p>
                    }
                    else
                    {
                        <div style="white-space: pre-wrap;">
                            @Model.Description
                        </div>
                    }

                </div>

            </div>



            <!-- =================================================
                 COMMENTS
                 ================================================= -->

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Comments
                    </h5>


                    <!-- Add Comment -->
                    <form asp-controller="Task"
                          asp-action="AddComment"
                          asp-route-workspaceId="@Model.WorkspaceId"
                          asp-route-boardId="@Model.BoardId"
                          asp-route-listId="@Model.ListId"
                          asp-route-taskId="@Model.Id"
                          method="post"
                          class="mb-4">

                        @Html.AntiForgeryToken()

                        <div class="mb-2">

                            <textarea name="content"
                                      class="form-control"
                                      rows="3"
                                      maxlength="2000"
                                      placeholder="Write a comment..."></textarea>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-sm">
                            Add Comment
                        </button>

                    </form>



                    <!-- Existing Comments -->
                    @if (Model.Comments.Count == 0)
                    {
                        <div class="text-muted">
                            No comments yet.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var comment in Model.Comments)
                            {
                                <div class="border rounded p-3">

                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">

                                        <div>

                                            <strong>
                                                @comment.UserName
                                            </strong>

                                            <span class="text-muted small ms-2">
                                                @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </span>

                                        </div>


                                        <form asp-controller="Task"
                                              asp-action="DeleteComment"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.BoardId"
                                              asp-route-listId="@Model.ListId"
                                              asp-route-taskId="@Model.Id"
                                              asp-route-commentId="@comment.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </div>


                                    <div style="white-space: pre-wrap;">
                                        @comment.Content
                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- =====================================================
             RIGHT COLUMN
             ===================================================== -->

        <div class="col-lg-4">


            <!-- Task Information -->
            <div class="card shadow-sm border-0 mb-4">

                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Task Information
                    </h5>


                    <div class="mb-3">

                        <div class="text-muted small">
                            Created by
                        </div>

                        <div class="fw-semibold">
                            @Model.CreatorName
                        </div>

                    </div>


                    <div class="mb-3">

                        <div class="text-muted small">
                            Created
                        </div>

                        <div>
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                    </div>


                    <div>

                        <div class="text-muted small">
                            Last updated
                        </div>

                        <div>
                            @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 ASSIGNEES
                 ================================================= -->

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Assignees
                    </h5>


                    @if (Model.Assignees.Count == 0)
                    {
                        <p class="text-muted">
                            No one is assigned to this task.
                        </p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">

                            @foreach (var assignee in Model.Assignees)
                            {
                                <div class="d-flex justify-content-between align-items-center border rounded p-2">

                                    <span>
                                        @assignee.UserName
                                    </span>


                                    @if (Model.CanManage)
                                    {
                                        <form asp-controller="Task"
                                              asp-action="Unassign"
                                              asp-route-workspaceId="@Model.WorkspaceId"
                                              asp-route-boardId="@Model.BoardId"
                                              asp-route-listId="@Model.ListId"
                                              asp-route-taskId="@Model.Id"
                                              asp-route-userId="@assignee.UserId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Remove
                                            </button>

                                        </form>
                                    }

                                </div>
                            }

                        </div>
                    }


                    <!-- Assign Member -->
                    @if (Model.CanManage)
                    {
                        <hr class="my-4" />

                        <h6 class="fw-semibold mb-3">
                            Assign Member
                        </h6>


                        <form asp-controller="Task"
                              asp-action="Assign"
                              asp-route-workspaceId="@Model.WorkspaceId"
                              asp-route-boardId="@Model.BoardId"
                              asp-route-listId="@Model.ListId"
                              asp-route-taskId="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()


                            <div class="mb-3">

                                <select name="userId"
                                        class="form-select">

                                    <option value="">
                                        Select member
                                    </option>


                                    @foreach (var member in Model.WorkspaceMembers)
                                    {
                                        if (!Model.Assignees.Any(
                                            assignee => assignee.UserId == member.UserId))
                                        {
                                            <option value="@member.UserId">
                                                @member.UserName
                                            </option>
                                        }
                                    }

                                </select>

                            </div>


                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Assign Member
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</div>