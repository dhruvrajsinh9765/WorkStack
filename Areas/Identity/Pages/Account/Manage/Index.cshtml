@page
@model IndexModel

@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="ws-account-page">

    <div class="ws-account-page-header">
        <div>
            <span class="ws-page-eyebrow">ACCOUNT SETTINGS</span>
            <h1>Profile</h1>
            <p>Manage the username associated with your WorkStack account.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="ws-account-settings-card">

        <div class="ws-settings-card-header">
            <div class="ws-settings-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.5" />
                    <path d="M5 20a7 7 0 0 1 14 0" />
                </svg>
            </div>

            <div>
                <h2>Personal information</h2>
                <p>Update how your name appears across WorkStack.</p>
            </div>
        </div>

        <form id="profile-form"
              method="post"
              class="ws-account-form">

            <div asp-validation-summary="ModelOnly"
                 class="ws-auth-validation"
                 role="alert">
            </div>

            <div class="ws-form-field">
                <label asp-for="Username">Username</label>

                <input asp-for="Username"
                       class="ws-account-input"
                       placeholder="Choose your username."
                       autocomplete="username" />

                <span asp-validation-for="Username"
                      class="ws-field-validation">
                </span>
            </div>

            <div class="ws-account-form-actions">
                <button id="update-profile-button"
                        type="submit"
                        class="ws-settings-save">
                    Save changes
                </button>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}