@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="ws-account-page">

    <div class="ws-account-page-header">
        <div>
            <span class="ws-page-eyebrow">ACCOUNT SETTINGS</span>
            <h1>Change password</h1>
            <p>Keep your WorkStack account protected with a strong password.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="ws-account-settings-card">

        <div class="ws-settings-card-header">
            <div class="ws-settings-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="10" rx="2" />
                    <path d="M8 10V7.5a4 4 0 0 1 8 0V10" />
                </svg>
            </div>

            <div>
                <h2>Password security</h2>
                <p>Enter your current password before choosing a new one.</p>
            </div>
        </div>

        <form id="change-password-form"
              method="post"
              class="ws-account-form">

            <div asp-validation-summary="ModelOnly"
                 class="ws-auth-validation"
                 role="alert">
            </div>

            <div class="ws-form-field">
                <label asp-for="Input.OldPassword">
                    Current password
                </label>

                <input asp-for="Input.OldPassword"
                       class="ws-account-input"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your current password." />

                <span asp-validation-for="Input.OldPassword"
                      class="ws-field-validation">
                </span>
            </div>

            <div class="ws-form-field">
                <label asp-for="Input.NewPassword">
                    New password
                </label>

                <input asp-for="Input.NewPassword"
                       class="ws-account-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Enter your new password." />

                <span asp-validation-for="Input.NewPassword"
                      class="ws-field-validation">
                </span>
            </div>

            <div class="ws-form-field">
                <label asp-for="Input.ConfirmPassword">
                    Confirm new password
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="ws-account-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm your new password." />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="ws-field-validation">
                </span>
            </div>

            <div class="ws-password-note">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5" />
                    <path d="M12 10v5M12 7.5v.1" />
                </svg>

                <span>
                    Your password must satisfy the requirements configured
                    for your WorkStack account.
                </span>
            </div>

            <div class="ws-account-form-actions">
                <button type="submit"
                        class="ws-settings-save">
                    Update password
                </button>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}